# =============================================================
# n8n Docker Compose – Environment Configuration
# =============================================================
# USAGE
#   1. Copy this file:   cp .env.example .env
#   2. Replace every placeholder value below with real values.
#   3. Start the stack:  docker compose up -d
#   4. Open http://localhost:5678/setup and enter the owner
#      details from the N8N_OWNER_* variables below.
#
# WARNING: Keep the .env file private. It is listed in
#          .gitignore and must never be committed to Git.
# =============================================================

# -------------------------------------------------------------
# n8n – Owner account (used during the first-time setup wizard)
# Open http://localhost:5678/setup after first launch and enter
# these values to create the owner account.
# IMPORTANT: Change the password to a strong, unique value.
#            Suggested command:  openssl rand -base64 18
# -------------------------------------------------------------
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=User
N8N_OWNER_PASSWORD=n8nAdmin2024!

# -------------------------------------------------------------
# n8n – Encryption key
# Used to encrypt credentials stored in the database.
# Generate a fresh key with:  openssl rand -hex 32
# Replace the placeholder below BEFORE first launch.
# -------------------------------------------------------------
N8N_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# -------------------------------------------------------------
# PostgreSQL – Database credentials
# These are used by both the postgres container and n8n.
# IMPORTANT: Change the password to a strong, unique value.
#            Suggested command:  openssl rand -base64 18
# -------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=PgPassword2024!

# -------------------------------------------------------------
# Timezone (optional)
# Uses IANA timezone names, e.g. America/New_York, Europe/Berlin
# Defaults to UTC if not set.
# -------------------------------------------------------------
TIMEZONE=UTC
