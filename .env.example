# =============================================================
# n8n Docker Compose – Environment Configuration
# =============================================================
# USAGE
#   1. Copy this file:   cp .env.example .env
#   2. (Optional) Change the values below to your preference.
#   3. Start the stack:  docker compose up -d
#
# WARNING: Keep the .env file private. It is listed in
#          .gitignore and must never be committed to Git.
# =============================================================

# -------------------------------------------------------------
# n8n – Basic Authentication
# The UI at http://localhost:5678 is protected by these creds.
# IMPORTANT: Change the password below to a strong, unique value
#            before first launch. Suggested command:
#              openssl rand -base64 18
# -------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8nAdmin2024!

# -------------------------------------------------------------
# n8n – Encryption key
# Used to encrypt credentials stored in the database.
# Generate a fresh key with:  openssl rand -hex 32
# Replace the placeholder below BEFORE first launch.
# -------------------------------------------------------------
N8N_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# -------------------------------------------------------------
# PostgreSQL – Database credentials
# These are used by both the postgres container and n8n.
# IMPORTANT: Change the password below to a strong, unique value
#            before first launch. Suggested command:
#              openssl rand -base64 18
# -------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=PgPassword2024!

# -------------------------------------------------------------
# Timezone (optional)
# Uses IANA timezone names, e.g. America/New_York, Europe/Berlin
# Defaults to UTC if not set.
# -------------------------------------------------------------
TIMEZONE=UTC
